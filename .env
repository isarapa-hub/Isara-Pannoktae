# พอร์ตของระบบ Backend API
PORT=5000

# การเชื่อมต่อฐานข้อมูล MySQL (XAMPP ค่าเริ่มต้น)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=project_jp

# ==============================================================
# การตั้งค่าการส่งอีเมลแจ้งเตือนสมาชิก (Gmail / SMTP)
# ==============================================================
# 1. EMAIL_USER: บัญชี Gmail ของคุณ (เช่น yourname@gmail.com)
# 2. EMAIL_PASS: รหัสผ่านสำหรับแอป 16 หลัก (App Password)
#    วิธีขอ: บัญชี Google > ความปลอดภัย > การยืนยันแบบ 2 ขั้นตอน > รหัสผ่านสำหรับแอป (App Password)
# (หากเว้นว่างไว้ ระบบจะจำลองการส่งและแสดง Preview URL ให้อัตโนมัติสำหรับการทดสอบ)
EMAIL_USER=
EMAIL_PASS=

# ที่อยู่หน้าเว็บ Frontend (สำหรับสร้างลิงก์ในอีเมลแจ้งเตือน)
FRONTEND_URL=http://localhost:5173

